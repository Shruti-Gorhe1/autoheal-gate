# Copy this file to backend/.env and fill in the values marked REQUIRED.
# Nothing in this file needs a paid service.

# ============================================================== application
APP_ENV=local
APP_NAME=AutoHeal Gate
LOG_LEVEL=INFO

# Public URLs. Change these before deploying anywhere but your own machine.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Encrypts stored GitHub tokens and signs internal identifiers. Rotating this
# value logs every user out; treat it like a database password.
SECRET_KEY=change-me-before-you-deploy-anywhere

# ================================================================= database
# SQLite needs no separate server. Point this at Postgres for a team
# deployment; nothing else in the app needs to change.
DATABASE_URL=sqlite:///./autoheal.db

# ============================================================ github oauth
# REQUIRED. Create at: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:            http://localhost:5173
#   Authorization callback:  http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
GITHUB_OAUTH_SCOPE=repo read:user

# Optional, but required for the webhook route to accept GitHub's requests.
# Set the same value as the "Secret" field on the repository webhook.
GITHUB_WEBHOOK_SECRET=

# =========================================================== azure devops
# Server-side PAT used by the Azure Repos / Azure Pipelines provider.
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_BASE_URL=https://dev.azure.com
# Optional Basic Auth credentials for the Azure DevOps service hook.
# Leave both blank for local development; configure both for a public endpoint.
AZURE_WEBHOOK_USERNAME=
AZURE_WEBHOOK_PASSWORD=

# ================================================================= sessions
SESSION_COOKIE_NAME=autoheal_session
SESSION_TTL_HOURS=12
# Set true once the backend is served over HTTPS.
SESSION_COOKIE_SECURE=false

# =================================================================== agent
# auto           -> use the LLM engine if reachable, else deterministic rules
# deterministic  -> rules only, zero cost, zero external calls
# adk            -> require the LLM engine; fail back to rules with a warning
AGENT_ENGINE=auto

# Local LLM, free and private. Requires Ollama running (see requirements-llm.txt):
#   ollama pull llama3.2
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

# =============================================================== execution
WORKSPACE_ROOT=./workspaces
DEFAULT_TEST_COMMAND=python -m pytest -q
TEST_TIMEOUT_SECONDS=300
SAMPLE_REPO_PATH=../sample-repo

# ===================================================================== rag
RAG_KNOWLEDGE_DIR=../knowledge_base
RAG_TOP_K=4
# Requires requirements-rag.txt. Falls back to a lexical scorer without it.
RAG_USE_SEMANTIC=false
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ========================================================== observability
# Requires requirements-observability.txt and a running Phoenix instance:
#   python -m phoenix.server.main serve   # http://localhost:6006
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=autoheal-gate
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
OTEL_CONSOLE_EXPORTER=false

# ================================================================= safety
# If the gate itself errors, block the pipeline rather than let it through.
GATE_FAIL_CLOSED=true
RATE_LIMIT_PER_MINUTE=120
SEED_DEMO_REPOSITORY=true

# ------------------------------------------------------- Google Cloud Build
google_cloud_project=
google_cloud_location=global
google_application_credentials=
google_cloud_access_token=
gcp_webhook_secret=

# --------------------------------------------------------------- queue
# Local/free Phase 8 worker pool.
QUEUE_MAX_SIZE=1000
QUEUE_WORKER_COUNT=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_SECONDS=0.5
QUEUE_POLL_INTERVAL_SECONDS=0.25
